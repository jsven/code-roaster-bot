# 复制到服务器 /opt/code-review/production.env，再填写实际值。
# docker run --env-file 使用 KEY=value，不要使用 export 或 ${变量} 引用。
HOST=0.0.0.0
PORT=3000
DATABASE_PATH=/app/data/reviews.db
WORKSPACE_ROOT=/app/data/workspaces

GITLAB_BASE_URL=https://gitlab.example.com
GITLAB_TOKEN=
GITLAB_WEBHOOK_SECRET=

OPENAI_API_KEY=
# 留空使用程序内置的官方 API 基址；自定义服务需支持 Responses API。
OPENAI_BASE_URL=
CODEX_MODEL=
CODEX_REASONING_EFFORT=medium
CODEX_SANDBOX=read-only
CODEX_APPROVAL_POLICY=never
CODEX_EPHEMERAL=true
CODEX_PROMPT_FILE=/app/prompts/code-review.md
CODEX_TIMEOUT_MS=900000
CODEX_MAX_OUTPUT_BYTES=2000000

FEISHU_ENABLED=false
FEISHU_WEBHOOK_URL=
FEISHU_SECRET=
FEISHU_MIN_SEVERITY=medium
FEISHU_TIMEOUT_MS=10000
