HOST=0.0.0.0
PORT=3000
DATABASE_PATH=./data/reviews.db
WORKSPACE_ROOT=./data/workspaces

GITLAB_BASE_URL=https://gitlab.example.com
GITLAB_TOKEN=
GITLAB_WEBHOOK_SECRET=

# API Key 模式：填写后不需要 codex login；两项留空则使用已有 Codex 登录/配置。
OPENAI_API_KEY=
# 留空使用 OpenAI 官方地址；自定义服务填写 API 基址（通常含 /v1），需支持 Responses API。
OPENAI_BASE_URL=

CODEX_COMMAND=codex
CODEX_ARGS=exec
CODEX_MODEL=
CODEX_REASONING_EFFORT=medium
CODEX_SANDBOX=read-only
CODEX_APPROVAL_POLICY=never
CODEX_PROFILE=
CODEX_EPHEMERAL=true
CODEX_OUTPUT_SCHEMA=
CODEX_PROMPT_FILE=./prompts/code-review.md
CODEX_TIMEOUT_MS=900000
CODEX_MAX_OUTPUT_BYTES=2000000

FEISHU_ENABLED=false
FEISHU_WEBHOOK_URL=
FEISHU_SECRET=
FEISHU_MIN_SEVERITY=medium
FEISHU_TIMEOUT_MS=10000
